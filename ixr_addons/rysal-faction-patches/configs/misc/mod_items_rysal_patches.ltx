; Separate lootable items for each faction.
; Until the Leekos texture atlas is imported, show the vanilla PDA icon.
; IX-Ray >= 1.3: icons_texture = ui\rysal_faction_patches
; Then set inv_grid_x/y for each patch to the atlas cell.
[rysal_patch_stalker]:guitar_a
$spawn           = "rysal\faction_patches\stalker"
visual           = dynamics\devices\dev_pda\dev_pda.ogf
inv_name         = rysal_patch_stalker_name
inv_name_short   = rysal_patch_stalker_name
description      = rysal_patch_stalker_desc
inv_weight       = 0.02
cost             = 100
inv_grid_width   = 1
inv_grid_height  = 1
inv_grid_x       = 6
inv_grid_y       = 13
auto_attach      = false

