inv_weight       = 0.02
cost             = 100
icons_texture    = ui\ui_leekos_patches
inv_scale        = 2
inv_grid_width   = 1
inv_grid_height  = 1
inv_grid_x       = 8
inv_grid_y       = 0
auto_attach      = false

