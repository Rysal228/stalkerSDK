-- Six independent, repeatable faction patch contracts for Owl (Sych).
-- Requires the separate rysal-faction-patches addon.
-- Each completion gives five patches to Owl; Lua pays a fresh random amount once.

-- Dialogues are attached directly to Owl by XMLOverride in IX-Ray 1.3.4.
-- The predicate below is a second-level restriction to this NPC.
local logged_npc_names = {}

function is_owl(first_speaker, second_speaker)
    if db.actor == nil then
        return false
    end

    -- The vanilla CoP Owl is identified by NPC object name.
    -- "zat_b30_owl_stalker_trader_id" is not guaranteed to be a story ID
    -- in CoP; an absent story ID used to silently hide this dialogue.
    local npc = dialogs.who_is_npc(first_speaker, second_speaker)
    if npc == nil then
        return false
    end

    local name = npc:name()
    if name ~= nil and not logged_npc_names[name] then
        logged_npc_names[name] = true
        SemiLog("[Rysal Owl] dialogue NPC name=" .. name)
    end

    return name ~= nil
        and string.find(name, "zat_b30_owl_stalker_trader", 1, true) ~= nil
end

local NEED_COUNT = 5
local order_names = {"bandit", "stalker", "freedom", "dolg", "killer", "monolith"}
local orders = {
    bandit = {
        item = "rysal_patch_bandit",
        min_reward = 500,
        max_reward = 2000,
        task = "rysal_owl_patch_bandit_task",
        started = "rysal_owl_patch_bandit_started",
        done = "rysal_owl_patch_bandit_done"
    },
    stalker = {
        item = "rysal_patch_stalker",
        min_reward = 1000,
        max_reward = 3000,
        task = "rysal_owl_patch_stalker_task",
        started = "rysal_owl_patch_stalker_started",
        done = "rysal_owl_patch_stalker_done"
    },
    freedom = {
        item = "rysal_patch_freedom",
        min_reward = 1500,
        max_reward = 4000,
        task = "rysal_owl_patch_freedom_task",
        started = "rysal_owl_patch_freedom_started",
        done = "rysal_owl_patch_freedom_done"
    },
    dolg = {
        item = "rysal_patch_dolg",
        min_reward = 2000,
        max_reward = 5000,
        task = "rysal_owl_patch_dolg_task",
        started = "rysal_owl_patch_dolg_started",
        done = "rysal_owl_patch_dolg_done"
    },
    killer = {
        item = "rysal_patch_killer",
        min_reward = 3000,
        max_reward = 7000,
        task = "rysal_owl_patch_killer_task",
        started = "rysal_owl_patch_killer_started",
        done = "rysal_owl_patch_killer_done"
    },
    monolith = {
        item = "rysal_patch_monolith",
        min_reward = 5000,
        max_reward = 10000,
        task = "rysal_owl_patch_monolith_task",
        started = "rysal_owl_patch_monolith_started",
        done = "rysal_owl_patch_monolith_done"
    }
}

local function has_order_started(order)
    return has_alife_info(order.started)
end

local function has_order_done(order)
    return has_alife_info(order.done)
end

-- Reuse the same task ID only after the previous instance is fully closed.
-- task_info is released by task_manager.task_callback after completion.
-- get_task(..., true) additionally checks the game's active task registry.
local function previous_task_finished(order)
    local manager = task_manager.get_task_manager()

    return manager.task_info[order.task] == nil
        and db.actor:get_task(order.task, true) == nil
end

local function can_accept(id)
    local order = orders[id]
    if db.actor == nil or order == nil then
        return false
    end

    -- The previous batch was delivered: waiting for task closure/reward.
    if has_order_done(order) then
        return previous_task_finished(order)
    end

    -- A never-taken order has neither flag; always display its offer.
    -- Only a repeat attempt requires waiting for the old task to close.
    return not has_order_started(order)
end

local function item_count(section)
    if db.actor == nil then
        return 0
    end

    local result = 0
    local function check_item(_, item)
        if item:section() == section then
            result = result + 1
        end
    end

    db.actor:iterate_inventory(check_item, nil)
    return result
end

local function can_turn_in(id)
    local order = orders[id]
    return db.actor ~= nil and order ~= nil
        and has_order_started(order)
        and not has_order_done(order)
        and item_count(order.item) >= NEED_COUNT
end

local function accept(id)
    if not can_accept(id) then
        return
    end

    local order = orders[id]

    -- Reset flags only when the player accepts a NEW cycle, not on delivery:
    -- clearing "done" at delivery would prevent the previous task's reward.
    if has_order_done(order) then
        db.actor:disable_info_portion(order.done)
    end
    if has_order_started(order) then
        db.actor:disable_info_portion(order.started)
    end

    task_manager.get_task_manager():give_task(order.task)
    db.actor:give_info_portion(order.started)
end

local function turn_in(id, first_speaker, second_speaker)
    if not can_turn_in(id) then
        return
    end

    local order = orders[id]
    dialogs.relocate_item_section_from_actor(
        first_speaker, second_speaker, order.item, NEED_COUNT
    )
    -- Pay one random amount for this delivery, then mark the task done.
    -- reward_money is deliberately ABSENT in the LTX: the task manager
    -- must not pay a second fixed reward on completion.
    -- Round the deal to whole hundreds, including both limits.
    local reward = math.random(order.min_reward / 100, order.max_reward / 100) * 100
    dialogs.relocate_money_to_actor(first_speaker, second_speaker, reward)
    SemiLog("[Rysal Owl] delivered " .. id .. ", paid " .. tostring(reward))

    -- Keep the done flag set until the task manager completes/clears the task.
    db.actor:give_info_portion(order.done)
end

function has_available_offers(first_speaker, second_speaker)
    for _, id in ipairs(order_names) do
        if can_accept(id) then
            return true
        end
    end
    return false
end

function has_active_orders(first_speaker, second_speaker)
    if db.actor == nil then
        return false
    end

    for _, id in ipairs(order_names) do
        local order = orders[id]
        if has_order_started(order) and not has_order_done(order) then
            return true
        end
    end
    return false
end

function can_accept_bandit(first_speaker, second_speaker)
    return can_accept("bandit")
end

function accept_bandit(first_speaker, second_speaker)
    accept("bandit")
end

function can_turn_in_bandit(first_speaker, second_speaker)
    return can_turn_in("bandit")
end

function turn_in_bandit(first_speaker, second_speaker)
    turn_in("bandit", first_speaker, second_speaker)
end

