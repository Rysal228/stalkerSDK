<?xml version="1.0" encoding="windows-1251"?>
<game_dialogs>
    <!-- New, independent dialogue; does not replace Owl's vanilla choices. -->
    <dialog id="rysal_owl_patch_offer" override="add">
        <!-- Always expose the entry point; each order has its own precondition.
             This avoids suppressing the entire dialogue before the script
             has been loaded or an older save has reconciled its task state. -->
        <phrase_list>
            <phrase id="0">
                <text>rysal_owl_patch_offer_0</text>
                <next>1</next>
            </phrase>
            <phrase id="1">
                <text>rysal_owl_patch_offer_1</text>
                <next>2</next>
                <next>3</next>
                <next>4</next>
                <next>5</next>
                <next>6</next>
                <next>7</next>
                <next>8</next>
            </phrase>
            <phrase id="2">
                <text>rysal_owl_patch_choose_bandit</text>
                <precondition>rysal_owl_patch_quests.can_accept_bandit</precondition>
                <action>rysal_owl_patch_quests.accept_bandit</action>
            </phrase>
            <phrase id="3">
                <text>rysal_owl_patch_choose_stalker</text>
                <precondition>rysal_owl_patch_quests.can_accept_stalker</precondition>
                <action>rysal_owl_patch_quests.accept_stalker</action>
            </phrase>
            <phrase id="4">
                <text>rysal_owl_patch_choose_freedom</text>
                <precondition>rysal_owl_patch_quests.can_accept_freedom</precondition>
                <action>rysal_owl_patch_quests.accept_freedom</action>
            </phrase>
            <phrase id="5">
                <text>rysal_owl_patch_choose_dolg</text>
                <precondition>rysal_owl_patch_quests.can_accept_dolg</precondition>
                <action>rysal_owl_patch_quests.accept_dolg</action>
            </phrase>
            <phrase id="6">
                <text>rysal_owl_patch_choose_killer</text>
                <precondition>rysal_owl_patch_quests.can_accept_killer</precondition>
                <action>rysal_owl_patch_quests.accept_killer</action>
            </phrase>
            <phrase id="7">
                <text>rysal_owl_patch_choose_monolith</text>
                <precondition>rysal_owl_patch_quests.can_accept_monolith</precondition>
                <action>rysal_owl_patch_quests.accept_monolith</action>
            </phrase>
            <phrase id="8">
                <text>rysal_owl_patch_later</text>
            </phrase>
        </phrase_list>
    </dialog>

    <dialog id="rysal_owl_patch_turn_in" override="add">
        <precondition>rysal_owl_patch_quests.has_active_orders</precondition>
        <phrase_list>
            <phrase id="0">
                <text>rysal_owl_patch_turn_in_0</text>
                <next>1</next>
            </phrase>
            <phrase id="1">
                <text>rysal_owl_patch_turn_in_1</text>
                <next>2</next>
                <next>3</next>
                <next>4</next>
                <next>5</next>
                <next>6</next>
                <next>7</next>
                <next>8</next>
            </phrase>
            <phrase id="2">
                <text>rysal_owl_patch_deliver_bandit</text>
                <precondition>rysal_owl_patch_quests.can_turn_in_bandit</precondition>
                <action>rysal_owl_patch_quests.turn_in_bandit</action>
            </phrase>
            <phrase id="3">
                <text>rysal_owl_patch_deliver_stalker</text>
                <precondition>rysal_owl_patch_quests.can_turn_in_stalker</precondition>
                <action>rysal_owl_patch_quests.turn_in_stalker</action>
            </phrase>
            <phrase id="4">
                <text>rysal_owl_patch_deliver_freedom</text>
                <precondition>rysal_owl_patch_quests.can_turn_in_freedom</precondition>
                <action>rysal_owl_patch_quests.turn_in_freedom</action>
            </phrase>
            <phrase id="5">
                <text>rysal_owl_patch_deliver_dolg</text>
                <precondition>rysal_owl_patch_quests.can_turn_in_dolg</precondition>
                <action>rysal_owl_patch_quests.turn_in_dolg</action>
            </phrase>
            <phrase id="6">
                <text>rysal_owl_patch_deliver_killer</text>
                <precondition>rysal_owl_patch_quests.can_turn_in_killer</precondition>
                <action>rysal_owl_patch_quests.turn_in_killer</action>
            </phrase>
            <phrase id="7">
                <text>rysal_owl_patch_deliver_monolith</text>
                <precondition>rysal_owl_patch_quests.can_turn_in_monolith</precondition>
                <action>rysal_owl_patch_quests.turn_in_monolith</action>
            </phrase>
            <phrase id="8">
                <text>rysal_owl_patch_not_ready</text>
            </phrase>
        </phrase_list>
    </dialog>
</game_dialogs>
